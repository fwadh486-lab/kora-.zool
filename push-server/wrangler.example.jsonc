{
  "name": "korazol-push",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-20",
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "APP_ORIGIN": "https://fwadh486-lab.github.io",
    "APP_URL": "https://fwadh486-lab.github.io/kora-.zool/"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "korazol-push", "database_id": "REPLACE_WITH_D1_DATABASE_ID" }
  ]
}
